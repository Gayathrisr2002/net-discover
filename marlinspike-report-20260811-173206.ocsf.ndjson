{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":4,"severity":"High","confidence_id":3,"confidence":"92","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0840:ics-attack","title":"Network Connection Enumeration","desc":"A device observed as the target of a port scan has been actively enumerated by another host on the network \u2014 T0840 in the ICS context. Active network enumeration of OT devices is a pre-exploitation reconnaissance step and is anomalous in well-managed OT environments where communication paths are fixed and deterministic.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"}],"attacks":[{"version":"18.1","technique":{"uid":"T0840","name":"Network Connection Enumeration","src_url":"https://attack.mitre.org/techniques/T0840"},"tactics":[{"uid":"TA0102","name":"Discovery","src_url":"https://attack.mitre.org/tactics/TA0102"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"observed","mapped_from":["PORT_SCAN_TARGET"],"evidence_refs":["finding:port-scan-target:1"],"capture_id":"cap_00001_20260811172057"}}}
{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":4,"severity":"High","confidence_id":3,"confidence":"88","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0846:ics-attack","title":"Remote System Discovery","desc":"Port scan traffic targeting an OT device indicates systematic remote system discovery \u2014 an adversary mapping the OT network to identify reachable assets, their roles, and their service fingerprints prior to selecting exploitation targets. OT-aware scanners (PLCScan, ModbusPal in scan mode) actively probe ICS-specific ports to enumerate controllers and field devices.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"}],"attacks":[{"version":"18.1","technique":{"uid":"T0846","name":"Remote System Discovery","src_url":"https://attack.mitre.org/techniques/T0846"},"tactics":[{"uid":"TA0102","name":"Discovery","src_url":"https://attack.mitre.org/tactics/TA0102"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"observed","mapped_from":["PORT_SCAN_TARGET"],"evidence_refs":["finding:port-scan-target:1"],"capture_id":"cap_00001_20260811172057"}}}
{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":4,"severity":"High","confidence_id":3,"confidence":"85","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0886:ics-attack","title":"Remote Services","desc":"Traffic observed traversing Purdue model zone boundaries (e.g., Level 4 IT host communicating directly with Level 1-2 OT devices) indicates remote service access across the DMZ \u2014 a primary lateral movement path used by adversaries after gaining an IT foothold to reach OT assets.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.1","uid":"192.168.0.1"},{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"},{"type_id":0,"type":"Endpoint","name":"192.168.2.1","uid":"192.168.2.1"},{"type_id":0,"type":"Endpoint","name":"192.168.2.102","uid":"192.168.2.102"},{"type_id":0,"type":"Endpoint","name":"224.0.0.1","uid":"224.0.0.1"},{"type_id":0,"type":"Endpoint","name":"224.0.0.22","uid":"224.0.0.22"},{"type_id":0,"type":"Endpoint","name":"255.255.255.255","uid":"255.255.255.255"}],"attacks":[{"version":"18.1","technique":{"uid":"T0886","name":"Remote Services","src_url":"https://attack.mitre.org/techniques/T0886"},"tactics":[{"uid":"TA0108","name":"Initial Access","src_url":"https://attack.mitre.org/tactics/TA0108"},{"uid":"TA0109","name":"Lateral Movement","src_url":"https://attack.mitre.org/tactics/TA0109"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"observed","mapped_from":["CROSS_PURDUE"],"evidence_refs":["finding:cross-purdue:1"],"capture_id":"cap_00001_20260811172057"}}}
{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":3,"severity":"Medium","confidence_id":2,"confidence":"72","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0812:ics-attack","title":"Default Credentials","desc":"Auth-capable protocols (SSH, HTTPS, OPC-UA, Modbus with authentication extensions, S7comm) observed without any authentication exchange suggest devices are accepting connections without credential verification \u2014 consistent with factory-default configurations or disabled authentication. Default credentials are the most common lateral movement path in OT environments.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"},{"type_id":0,"type":"Endpoint","name":"192.168.2.101","uid":"192.168.2.101"}],"attacks":[{"version":"18.1","technique":{"uid":"T0812","name":"Default Credentials","src_url":"https://attack.mitre.org/techniques/T0812"},"tactics":[{"uid":"TA0109","name":"Lateral Movement","src_url":"https://attack.mitre.org/tactics/TA0109"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"inferred","mapped_from":["NO_AUTH_OBSERVED"],"evidence_refs":["finding:no-auth-observed:1"],"capture_id":"cap_00001_20260811172057"}}}
{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":3,"severity":"Medium","confidence_id":2,"confidence":"72","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0866:ics-attack","title":"Exploitation of Remote Services","desc":"Unauthorized cross-Purdue communication paths can indicate active exploitation of remote services across zone boundaries \u2014 particularly where IT hosts are communicating with OT devices over non-approved protocols. An adversary who exploits a service on an OT device from the IT zone achieves T0866 lateral movement without needing OT credentials.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.1","uid":"192.168.0.1"},{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"},{"type_id":0,"type":"Endpoint","name":"192.168.2.1","uid":"192.168.2.1"},{"type_id":0,"type":"Endpoint","name":"192.168.2.102","uid":"192.168.2.102"},{"type_id":0,"type":"Endpoint","name":"224.0.0.1","uid":"224.0.0.1"},{"type_id":0,"type":"Endpoint","name":"224.0.0.22","uid":"224.0.0.22"},{"type_id":0,"type":"Endpoint","name":"255.255.255.255","uid":"255.255.255.255"}],"attacks":[{"version":"18.1","technique":{"uid":"T0866","name":"Exploitation of Remote Services","src_url":"https://attack.mitre.org/techniques/T0866"},"tactics":[{"uid":"TA0108","name":"Initial Access","src_url":"https://attack.mitre.org/tactics/TA0108"},{"uid":"TA0109","name":"Lateral Movement","src_url":"https://attack.mitre.org/tactics/TA0109"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"inferred","mapped_from":["CROSS_PURDUE"],"evidence_refs":["finding:cross-purdue:1"],"capture_id":"cap_00001_20260811172057"}}}
{"class_uid":2004,"class_name":"Detection Finding","category_uid":2,"category_name":"Findings","activity_id":1,"type_uid":200401,"type_name":"Detection Finding: Create","time":1786449727070,"severity_id":3,"severity":"Medium","confidence_id":2,"confidence":"68","metadata":{"version":"1.4.0","product":{"name":"MarlinSpike","vendor_name":"ERISFORGE Ltd.","version":"3.7.0"}},"finding_info":{"uid":"mitre:T0891:ics-attack","title":"Hardcoded Credentials","desc":"Absence of observed authentication on protocols that nominally support it may indicate hardcoded credentials in firmware \u2014 devices that technically require a credential but accept a fixed, unchangeable password embedded at the factory. Hardcoded credentials persist across power cycles and cannot be rotated without firmware updates.\n","types":["mitre_attack_classification"],"first_seen_time":1786449727070},"affected_resources":[{"type_id":0,"type":"Endpoint","name":"192.168.0.102","uid":"192.168.0.102"},{"type_id":0,"type":"Endpoint","name":"192.168.2.101","uid":"192.168.2.101"}],"attacks":[{"version":"18.1","technique":{"uid":"T0891","name":"Hardcoded Credentials","src_url":"https://attack.mitre.org/techniques/T0891"},"tactics":[{"uid":"TA0109","name":"Lateral Movement","src_url":"https://attack.mitre.org/tactics/TA0109"},{"uid":"TA0110","name":"Persistence","src_url":"https://attack.mitre.org/tactics/TA0110"}]}],"unmapped":{"marlinspike":{"domain":"ics-attack","basis":"inferred","mapped_from":["NO_AUTH_OBSERVED"],"evidence_refs":["finding:no-auth-observed:1"],"capture_id":"cap_00001_20260811172057"}}}
