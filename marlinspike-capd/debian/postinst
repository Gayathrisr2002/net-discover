#!/bin/sh
# postinst for marlinspike-capd
set -e

case "$1" in
  configure)
    if ! getent passwd marlinspike-capd >/dev/null 2>&1; then
      adduser --system --no-create-home --shell /usr/sbin/nologin \
        --group marlinspike-capd
    fi

    # dumpcap ships non-setuid on Debian/Ubuntu — only root or members of
    # the wireshark group may execute it. Without this, every capture
    # attempt fails with "dumpcap not found on PATH" despite dumpcap
    # being right there on PATH for root — confirmed the hard way on a
    # real deployment before this line existed.
    if getent group wireshark >/dev/null 2>&1; then
      adduser marlinspike-capd wireshark >/dev/null 2>&1 || true
    fi

    # If marlinspike-agent is already installed on this host (relaying
    # capture commands to us), it needs read access to the state
    # directory capd writes rotated PCAPs into (StateDirectoryMode=0750
    # in the systemd unit — deliberately group-restricted, not
    # world-readable like the RPC socket's directory, since this holds
    # actual captured traffic) so it can scan what it just captured.
    # Confirmed the hard way: capture start/stop worked fine over the
    # socket, but the agent's own scan step failed with a plain
    # FileNotFoundError reading the rotated file — group traversal, not
    # a missing file. See marlinspike-agent's postinst for the mirror
    # image of this (handles the reverse install order).
    if getent passwd marlinspike-agent >/dev/null 2>&1; then
      adduser marlinspike-agent marlinspike-capd >/dev/null 2>&1 || true
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi

    cat <<'EOF'

marlinspike-capd installed.

The socket only trusts root by default — the web app (or a remote
marlinspike-agent) connects as some other uid, which must be
explicitly allowed or every request fails as unauthorized:

  id -u marlinspike-agent   # (or whichever uid needs to connect)
  sudo systemctl edit --full marlinspike-capd
  # add --allow-uid=<that uid> to the ExecStart line, then:
  sudo systemctl daemon-reload
  sudo systemctl enable --now marlinspike-capd

See /usr/share/doc/marlinspike-capd/README.md for full details.
EOF

    if getent passwd marlinspike-agent >/dev/null 2>&1 && systemctl is-active --quiet marlinspike-agent 2>/dev/null; then
      cat <<'EOF'

marlinspike-agent is already running on this host — it was just added
to the marlinspike-capd group so it can read captured PCAPs, but an
already-running process won't see that until restarted:

  sudo systemctl restart marlinspike-agent
EOF
    fi
    ;;
esac

exit 0
