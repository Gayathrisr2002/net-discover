#!/bin/sh
# postinst for marlinspike-agent
set -e

case "$1" in
  configure)
    if ! getent passwd marlinspike-agent >/dev/null 2>&1; then
      adduser --system --no-create-home --shell /usr/sbin/nologin \
        --group marlinspike-agent
    fi

    mkdir -p /etc/marlinspike-agent
    chown marlinspike-agent:marlinspike-agent /etc/marlinspike-agent
    chmod 0700 /etc/marlinspike-agent

    # Install the bundled marlinspike-capd .deb (built alongside this
    # package — see scripts/build_agent_deb.sh) so a plain `dpkg -i` /
    # `apt install` of just this ONE file sets up a fully working sensor
    # host, not just the relay half. `Recommends: marlinspike-capd` in
    # debian/control alone isn't enough for that — it only resolves when
    # apt is given capd's own path in the same install command (or a repo
    # serves it, which this project doesn't have), so dpkg -i or a
    # single-file apt install would otherwise silently skip it. Skipped
    # if capd is already present (idempotent, matches the rest of this
    # script's re-run safety).
    CAPD_DEB="/usr/share/marlinspike-agent/marlinspike-capd.deb"
    if [ -f "$CAPD_DEB" ] && ! dpkg -s marlinspike-capd >/dev/null 2>&1; then
      echo "marlinspike-agent: installing bundled marlinspike-capd..."
      # wireshark-common (capd's own Depends) asks via debconf whether to
      # install dumpcap setuid-root for non-root capture — capd instead
      # grants CAP_NET_RAW/CAP_NET_ADMIN directly and gates access via
      # group membership (see marlinspike-capd's own postinst), so answer
      # "no" here. Necessary since this runs inside our own postinst,
      # non-interactively, with no TTY to answer an unanswered prompt.
      echo "wireshark-common wireshark-common/install-setuid boolean false" | debconf-set-selections
      DEBIAN_FRONTEND=noninteractive apt-get install -y "$CAPD_DEB" || \
        echo "marlinspike-agent: warning: automatic marlinspike-capd install failed — install it manually: sudo apt install $CAPD_DEB" >&2
    fi

    # If marlinspike-capd is present on this host (just installed above,
    # or already was), this agent
    # needs read access to the state directory it writes rotated PCAPs
    # into (StateDirectoryMode=0750, group-restricted — not the socket's
    # own directory, which is a separate, deliberately more permissive
    # concern) to actually scan what it captures. See marlinspike-capd's
    # postinst for the mirror image of this (handles the reverse install
    # order — whichever package installs second is the one that can
    # actually see both users/groups to wire this up).
    if getent group marlinspike-capd >/dev/null 2>&1; then
      adduser marlinspike-agent marlinspike-capd >/dev/null 2>&1 || true
    fi

    # capd's socket only trusts root by default and otherwise checks an
    # allow-list file it already watches (see marlinspike-capd's own
    # postinst / systemd unit) — add this agent's uid there too so a
    # capd-then-agent install order is wired up automatically, same as
    # agent-then-capd is from the other side.
    if [ -d /etc/marlinspike-capd ]; then
      mkdir -p /etc/marlinspike-capd
      touch /etc/marlinspike-capd/allowed-uids
      agent_uid="$(id -u marlinspike-agent)"
      grep -qxF "$agent_uid" /etc/marlinspike-capd/allowed-uids 2>/dev/null || \
        echo "$agent_uid" >> /etc/marlinspike-capd/allowed-uids
    fi

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi

    cat <<'EOF'

marlinspike-agent installed.

Next steps:
  1. Enroll with your fleet gateway (get the exact command, with your site's
     real gateway address and token already filled in, from the Fleet page):
       sudo marlinspike-agent enroll --gateway <your-gateway-host>:<port> --token <your-enrollment-token> \
           --ca-cert /path/to/fleet-ca.crt \
           --credential-file /etc/marlinspike-agent/credential.json
     Replace <your-gateway-host>:<port> and <your-enrollment-token> below --
     these are placeholders, not literal values to copy.
  2. The credential file above was just written by root (via sudo) --
     the service itself runs as the unprivileged marlinspike-agent user,
     so hand it ownership before starting:
       sudo chown marlinspike-agent:marlinspike-agent \
           /etc/marlinspike-agent/credential.json
  3. Start it:
       sudo systemctl enable --now marlinspike-agent

See /usr/share/doc/marlinspike-agent/README.md for full details.
EOF
    ;;
esac

exit 0
