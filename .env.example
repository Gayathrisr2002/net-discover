# DB_PASSWORD is embedded in the database connection URL
# (postgresql://marlinspike:DB_PASSWORD@db:5432/marlinspike), so it MUST be
# URL-safe: use letters and digits only. Symbols like @ : / ; # & % or spaces
# will corrupt the URL and the app will fail to start with an error such as
# 'could not translate host name'. SECRET_KEY / ADMIN_PASSWORD may contain symbols.
DB_PASSWORD=change-me-letters-and-digits-only
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me
PORT=5001
HOST=0.0.0.0
# APP_BIND_HOST controls which interface of the DOCKER HOST machine the
# web app's port is actually reachable on (HOST above is just the
# interface the Flask process itself listens on *inside* the container,
# always 0.0.0.0 there — unrelated). Defaults to 0.0.0.0 (reachable from
# anywhere on your network) paired with SESSION_COOKIE_SECURE=false below
# — the two must move together, since browsers refuse to send a
# Secure-flagged cookie back over plain HTTP to anything but localhost.
# This app has no TLS termination of its own, so only run it this way on
# a trusted/private network — session cookies travel in cleartext. Set
# APP_BIND_HOST=127.0.0.1 and SESSION_COOKIE_SECURE=true to lock it back
# down to this machine only.
APP_BIND_HOST=0.0.0.0
SESSION_COOKIE_SECURE=false
# Leave blank for single-process dev. Docker Compose defaults this to the
# bundled Redis service unless you override it.
RATELIMIT_STORAGE_URI=
PCAP_MAX_SIZE=5368709120
PCAP_PROCESS_SIZE=5368709120
MARLINSPIKE_DPI_REPO=https://github.com/eris-ot/marlinspike-dpi.git
MARLINSPIKE_DPI_REF=326bdbb744a7b8f71295381fd209d9587dc09a3b
MARLINSPIKE_MITRE_REPO=https://github.com/eris-ot/marlinspike-mitre.git
MARLINSPIKE_MITRE_REF=c3583ec2d189b8cde69f2160da6a5e8e5b643f7b
# Optional Stage 4b IOC engine. Leave MARLINSPIKE_MALWARE_REPO empty to skip bundling it.
MARLINSPIKE_MALWARE_REPO=https://github.com/eris-ot/marlinspike-malware.git
MARLINSPIKE_MALWARE_REF=4a008211cad7e56609e8a667b95f1c09b790c1b4
MARLINSPIKE_MALWARE_RULES_REPO=https://github.com/eris-ot/marlinspike-malware-rules.git
MARLINSPIKE_MALWARE_RULES_REF=99cbe9358d0a5047d9b5e57a7e4ff5eafdee9bd4

# CISA KEV + ICS advisory enrichment. Bundled plugin; no external repo needed.
# Disable to skip the CISA stage after each scan. Refresh the catalog with:
#   python3 plugins/marlinspike_cisa/../../scripts/sync_cisa_catalog.py
MARLINSPIKE_CISA_ENABLED=true
MARLINSPIKE_CISA_MODULE=plugins.marlinspike_cisa

# Live capture (optional, Linux only). See docs/live-capture.md.
# The capd sidecar already runs as part of the stack — this flag is the
# only thing gating it, set ENABLED=true and restart to enable.
LIVE_CAPTURE_ENABLED=false
LIVE_CAPTURE_SOCKET=/var/run/marlinspike-capd/marlinspike-capd.sock
LIVE_CAPTURE_TIMEOUT_S=5
LIVE_CAPTURE_MAX_CONCURRENT=2
# uid the capd uds socket will accept; defaults to root if unset.
# The app container runs as uid 1000 (see Dockerfile), so this must match
# that uid for the app to connect to capd (Docker Compose only).
LIVE_CAPTURE_ALLOW_UID=1000

# Fleet (remote sensor agents, optional — see docs/... and the Fleet page).
# FLEET_CA_CERT/FLEET_CA_KEY: run scripts/gen_dev_tls_cert.sh to generate
# certs/fleet-ca.{crt,key} and certs/gateway.{crt,key} before enabling the
# `fleet` profile; leaving these unset degrades to bearer-credential-only
# agent auth (no mTLS) instead of failing to start.
FLEET_CA_CERT=/certs/fleet-ca.crt
FLEET_CA_KEY=/certs/fleet-ca.key
# The REAL externally-exposed port (docker-compose.yml's fleet-gateway
# port mapping reads this one directly) — change this if 8765 is already
# taken on your host. Don't confuse it with FLEET_GATEWAY_PUBLIC_PORT
# below, which is display-only.
FLEET_GATEWAY_PORT=8765
# FLEET_GATEWAY_PUBLIC_HOST is normally left blank — certs-init
# auto-detects this host's real reachable address on every startup
# (scripts/refresh_gateway_cert.sh) and bakes it into the gateway TLS
# cert's Subject Alternative Names automatically, refreshing it again
# whenever the detected address changes (moved networks, new DHCP
# lease). The Fleet page's enroll-command display auto-detects
# separately too (from the request that loaded the page). Only set this
# explicitly to override auto-detection — a DNS hostname instead of an
# IP, a multi-homed/NATed host, or a VPN-facing address auto-detection
# would guess wrong for. FLEET_GATEWAY_PUBLIC_PORT is display-only
# (doesn't change what port is actually exposed — see FLEET_GATEWAY_PORT
# above for that).
FLEET_GATEWAY_PUBLIC_HOST=
FLEET_GATEWAY_PUBLIC_PORT=8765
